# --- LLM: Ollama (default, runs locally, no API key) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT_MS=180000
# --- or Google Gemini (set LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
PORT=5000
# ENABLE_DEV_CONTROLS=false hides the simulated-environment admin controls.
# Test mode without any LLM (rule-based, labelled in the UI): LLM_MODE=mock
